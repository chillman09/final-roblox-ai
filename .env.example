PORT=3000

# Storage: leave MONGODB_URI empty to keep everything in memory (fine for local dev, resets on restart).
MONGODB_URI=
# MONGODB_DB=animator

# Option A: Google Gemini (default)
GEMINI_API_KEY=
# GEMINI_MODEL writes new animations (use a stronger / reasoning model for better motion).
# GEMINI_FIX_MODEL does the quick automatic repair pass; GEMINI_FALLBACK_MODEL is tried if the first one fails.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FIX_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Option B: any OpenAI-compatible API (Groq, OpenRouter, ...). Setting LLM_BASE_URL switches to this.
# Groq:       LLM_BASE_URL=https://api.groq.com/openai/v1
# OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=
# LLM_FIX_MODEL=        (fast model for the automatic repair pass; defaults to LLM_FALLBACK_MODEL)
# LLM_FALLBACK_MODEL=
# LLM_JSON_MODE=off   (only if the model rejects JSON mode)

# Seconds before a model call is given up (default 60000 ms)
# LLM_TIMEOUT_MS=90000
